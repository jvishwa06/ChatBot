@page "/"
@using OllamaChatbot.Services

<div class="chat-container">
    <!-- Messages -->
    <div class="chat-messages">
        @foreach (var message in messages)
        {
            <div class="message @(message.IsUser ? "user-message" : "bot-message")">
                <p>@(message.IsUser ? $"User: {message.Content}" : $"LLM: {message.Content}")</p>
            </div>
        }
    </div>

    <!-- Input Area -->
    <div class="chat-input-wrapper">
        <div class="chat-input-container">
            <div class="input-with-button">
                <input @bind="userInput"
                       class="chat-input"
                       placeholder="Type a message..."
                       @onkeydown="HandleEnter" />

                <button @onclick="SendMessage" class="send-button">
                    <img src="/arrow.jpg" alt="Send" />
                </button>
            </div>
        </div>

        <!-- Warning Message -->
        <div class="warning-message">
            LLMs can make mistakes. Check important info.
        </div>
    </div>
</div>

<style>
    .chat-container {
        display: flex;
        flex-direction: column;
        height: 100%;
        background-color: #121212;
        color: white;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        background-color: #1f1f1f;
    }

    .message {
        padding: 10px;
        border-radius: 10px;
        max-width: 70%;
    }

    .user-message {
        align-self: flex-end;
        color: white;
    }

    .bot-message {
        align-self: flex-start;
        color: white;
    }

    .chat-input-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        background-color: #1f1f1f;
        padding: 10px 0;
        gap: 10px;
    }

    .chat-input-container {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 600px;
    }

    .input-with-button {
        display: flex;
        position: relative;
        width: 100%;
        background-color: #333;
        border-radius: 10px;
        align-items: center;
    }

    .chat-input {
        flex: 1;
        height: 50px;
        padding: 0 50px 0 15px;
        border: none;
        border-radius: 10px;
        background-color: #333;
        color: white;
        font-size: 16px;
    }

        .chat-input:focus {
            outline: none;
        }

    .send-button {
        position: absolute;
        right: 10px;
        width: 36px;
        height: 36px;
        background-color: white;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .send-button img {
            width: 20px;
            height: 20px;
        }

    .warning-message {
        font-size: 10px;
        color: white;
        text-align: center;
        margin: 0;
        padding: 0;
        background: none;
    }
</style>

@code {
    private string? userInput;
    private List<Message> messages = new();
    private int enterKeyPressCount = 0;

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(userInput))
        {
            string messageToSend = userInput; 
            userInput = string.Empty; 

            messages.Add(new Message { Content = messageToSend, IsUser = true });

            var llm = new OllamaLLM("qwen2.5:0.5b");
            var response = await llm.InvokeAsync(messageToSend);
            messages.Add(new Message { Content = response, IsUser = false });
        }
    }

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            enterKeyPressCount++;

            if (enterKeyPressCount == 2)
            {
                enterKeyPressCount = 0; 
                string? inputToSend = userInput; 
                userInput = string.Empty; 
                StateHasChanged(); 

                if (!string.IsNullOrWhiteSpace(inputToSend))
                {
                    messages.Add(new Message { Content = inputToSend, IsUser = true });

                    var llm = new OllamaLLM("qwen2.5:0.5b");
                    var response = await llm.InvokeAsync(inputToSend);
                    messages.Add(new Message { Content = response, IsUser = false });

                    StateHasChanged(); 
                }
            }
        }
    }

    private class Message
    {
        public string Content { get; set; } = string.Empty;
        public bool IsUser { get; set; }
    }
}